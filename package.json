{
  "name": "meidoya-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "meidoya": "node apps/meidoya/dist/main.js",
    "install:local": "pnpm build && node tools/install-local.mjs",
    "temporal:up": "docker compose -f deploy/local/compose.yaml up -d --wait",
    "temporal:down": "docker compose -f deploy/local/compose.yaml down",
    "temporal:logs": "docker compose -f deploy/local/compose.yaml logs -f temporal temporal-ui",
    "lima:temporal-proxy": "node tools/lima-loopback-proxy.mjs",
    "local:start": "pnpm temporal:up && pnpm build && node tools/local-run.mjs",
    "local:doctor": "node apps/meidoya/dist/main.js doctor",
    "audit:dependencies": "pnpm audit --audit-level=moderate",
    "lint": "eslint . --ext .ts",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p tools/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutation": "node tools/mutation/run.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.9.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
